# All variables are optional. Vendor logins are never read from the environment
# or from files; they are stored in the OS keyring (see README).

# --- Backend (set in the shell that runs uvicorn) ---

# Chat uses the rule-based coordinator and makes no model calls unless one of
# the next two is set. Both need `pip install -r requirements-agents.txt`.

# Set to claude_code to let a Claude model coordinate through the Claude Code
# sign-in on this computer (no API key). Leave ANTHROPIC_API_KEY unset with it:
# Claude Code may pick the key up and use the API instead of the sign-in.
FARMFIND_COORDINATOR=

# Or: a Claude API key for the same coordinator.
ANTHROPIC_API_KEY=

# Claude model used by the chat coordinator (default: claude-sonnet-5-5)
FARMFIND_MODEL=claude-sonnet-5-5

# --- Frontend (Vite; copy to frontend/.env.local to override) ---

# Base URL of the backend API (default: http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Show the product comparison table in the dashboard (default: hidden)
VITE_SHOW_PRODUCT_COMPARISON=false
